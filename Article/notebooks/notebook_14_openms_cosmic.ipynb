  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_cosmic_coverage(cosmic_all_total, cosmic_crc_total, overlap_all_count, overlap_crc_count, \n",
    "                        cov_all_pct, cov_crc_pct):\n",
    "    \"\"\"COSMICカバレッジの棒グラフを作成・保存する。\n",
    "    \n",
    "    Args:\n",
    "        cosmic_all_total: 全がん種COSMIC遺伝子総数\n",
    "        cosmic_crc_total: CRC特異的COSMIC遺伝子総数\n",
    "        overlap_all_count: 全がん種で検出された数\n",
    "        overlap_crc_count: CRCで検出された数\n",
    "        cov_all_pct: 全がん種カバー率\n",
    "        cov_crc_pct: CRCカバー率\n",
    "    \"\"\"\n",
    "    print(f\"📊 COSMICカバレッジ可視化作成中...\")\n",
    "    \n",
    "    # 1行2列のサブプロット（左: 全がん種、右: CRC）を作成\n",
    "    # figsize=(14, 6): 図全体の幅14インチ、高さ6インチ\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "    \n",
    "    # 棒グラフの色を定義: 深層学習用の紫系カラー（COSMIC総数）と深緑（同定数）\n",
    "    colors = [\"#9575CD\", \"#2E7D32\"]\n",
    "    \n",
    "    # 各パネルの描画パラメータをリストにまとめる（ループで処理するため）\n",
    "    # (軸オブジェクト, タイトル, COSMIC遺伝子数, 重複数, カバー率, ラベル)\n",
    "    panels = [\n",
    "        (axes[0], \"Deep Learning DIA: Cancer-Associated Proteins\", \n",
    "         cosmic_all_total, overlap_all_count, cov_all_pct, \"All Cancer\"),\n",
    "        (axes[1], \"Deep Learning DIA: CRC-Associated Proteins\", \n",
    "         cosmic_crc_total, overlap_crc_count, cov_crc_pct, \"CRC\"),\n",
    "    ]\n",
    "    \n",
    "    # 各パネルをループで描画する（左右のグラフで同じ描画ロジックを共有）\n",
    "    for ax, title, n_cosmic, n_overlap, cov, label in panels:\n",
    "        # x軸のカテゴリ名を定義（改行\\nで2行表示にして見やすくする）\n",
    "        cats = [f\"COSMIC\\n({label})\", \"Deep Learning\\nDIA Identified\"]\n",
    "        vals = [n_cosmic, n_overlap]  # y軸の値: COSMIC総数と同定数\n",
    "        \n",
    "        # 棒グラフを描画: width=0.6で棒の幅を指定、edgecolor=\"white\"で棒の境界線を白に\n",
    "        bars = ax.bar(cats, vals, color=colors, width=0.6, edgecolor=\"white\", linewidth=1.5)\n",
    "        \n",
    "        # グラフタイトルにカバー率を含めて表示（深層学習による高精度検出を強調）\n",
    "        ax.set_title(f\"{title}\\n(Coverage: {cov:.1f}%)\", fontsize=12, fontweight='bold', pad=20)\n",
    "        ax.set_ylabel(\"Number of Proteins\", fontsize=11)  # y軸ラベル: タンパク質数\n",
    "        \n",
    "        # 各棒の上端に数値ラベルを表示する（棒の高さ+値の5%上の位置に配置）\n",
    "        for bar, v in zip(bars, vals):\n",
    "            ax.text(bar.get_x() + bar.get_width() / 2, bar.get_height() + max(vals)*0.02,  \n",
    "                    str(v), ha=\"center\", fontweight=\"bold\", fontsize=11)  # ha=\"center\": 水平中央揃え\n",
    "        \n",
    "        # y軸の範囲を調整（最大値の110%まで表示して余白を確保）\n",
    "        ax.set_ylim(0, max(vals) * 1.15)\n",
    "        \n",
    "        # グリッドを薄く表示\n",
    "        ax.grid(True, alpha=0.3, linestyle='-', linewidth=0.5, axis='y')\n",
    "        \n",
    "        # 上と右の枠線を非表示にして、すっきりした見た目にする\n",
    "        ax.spines[\"top\"].set_visible(False)\n",
    "        ax.spines[\"right\"].set_visible(False)\n",
    "        \n",
    "        # x軸ラベルの文字を少し大きくして見やすくする\n",
    "        ax.tick_params(axis='x', labelsize=10)\n",
    "        ax.tick_params(axis='y', labelsize=9)\n",
    "    \n",
    "    # 全体のタイトルを追加\n",
    "    fig.suptitle(f\"Deep Learning DIA: COSMIC Cancer Gene Coverage\\n({len(identified):,} total proteins identified)\", \n",
    "                 fontsize=14, fontweight='bold', y=0.95)\n",
    "    \n",
    "    # サブプロット間の余白を自動調整して重なりを防ぐ\n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.9])  # 上部にタイトル用スペースを確保\n",
    "    \n",
    "    # 図をPNGファイルとして保存: dpi=150で高解像度、bbox_inches=\"tight\"で余白を最小化\n",
    "    output_path = FIG_DIR / \"fig_cosmic_coverage.png\"\n",
    "    fig.savefig(output_path, dpi=150, bbox_inches=\"tight\")\n",
    "    plt.close()\n",
    "    \n",
    "    print(f\"💾 COSMICカバレッジ図保存: {output_path}\")\n",
    "    return output_path\n",
    "\n",
    "# COSMICカバレッジ可視化を実行\n",
    "coverage_plot_path = plot_cosmic_coverage(\n",
    "    len(cosmic_all), len(cosmic_crc), \n",
    "    len(overlap_all), len(overlap_crc),\n",
    "    cov_all, cov_crc\n",
    ")"
   ]
