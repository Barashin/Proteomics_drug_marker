    "## 3. 🔧 信頼楕円のヘルパー関数\n",
    "\n",
    "PCA散布図で各群の95%信頼区間を楕円で表示するためのヘルパー関数を定義します。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def confidence_ellipse(x, y, ax, n_std=2.0, **kwargs):\n",
    "    \"\"\"95% 信頼楕円を描画する（PCA散布図用ヘルパー関数）。\n",
    "    \n",
    "    Args:\n",
    "        x, y: 各軸のデータ点（PC1, PC2のスコア）\n",
    "        ax: matplotlib Axes オブジェクト（描画対象）\n",
    "        n_std: 標準偏差の倍数（2.0 = 約95%信頼区間）\n",
    "        **kwargs: 楕円の外観設定（色、透明度等）\n",
    "    \n",
    "    Returns:\n",
    "        描画された楕円オブジェクト\n",
    "    \"\"\"\n",
    "    # データ点が2個未満では共分散を計算できないため、描画をスキップする\n",
    "    if len(x) < 2:\n",
    "        return None\n",
    "    \n",
    "    # xとyの共分散行列を計算する（2x2行列: 分散と共分散を含む）\n",
    "    cov = np.cov(x, y)\n",
    "    # ピアソン相関係数を計算する（xとyの線形関係の強さ。-1〜+1の範囲）\n",
    "    pearson = cov[0, 1] / np.sqrt(cov[0, 0] * cov[1, 1])\n",
    "    \n",
    "    # 楕円の横半径を計算する（相関が高いほど横長になる）\n",
    "    ell_rx = np.sqrt(1 + pearson)\n",
    "    # 楕円の縦半径を計算する（相関が高いほど縦短になる）\n",
    "    ell_ry = np.sqrt(1 - pearson)\n",
    "    \n",
    "    # 原点中心の楕円オブジェクトを作成する（**kwargsで色や透明度を受け取る）\n",
    "    ellipse = Ellipse((0, 0), width=ell_rx * 2, height=ell_ry * 2, **kwargs)\n",
    "    \n",
    "    # アフィン変換を組み合わせて楕円をデータの分布に合わせる\n",
    "    transf = (transforms.Affine2D()\n",
    "              .rotate_deg(45)  # 45度回転（共分散の主軸方向に合わせる）\n",
    "              # n_std倍の標準偏差に合わせてスケールする（n_std=2で約95%信頼区間）\n",
    "              .scale(np.sqrt(cov[0, 0]) * n_std, np.sqrt(cov[1, 1]) * n_std)\n",
    "              # データの重心位置に移動する\n",
    "              .translate(np.mean(x), np.mean(y)))\n",
    "    \n",
    "    # 変換を楕円に適用する（ax.transDataでデータ座標系に変換）\n",
    "    ellipse.set_transform(transf + ax.transData)\n",
    "    \n",
    "    # 楕円をAxesに追加して描画する\n",
    "    return ax.add_patch(ellipse)\n",
    "\n",
    "print(\"🔧 信頼楕円描画関数を定義しました\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 📊 有意差タンパク質の抽出と色設定\n",
    "\n",
    "統計検定で特定された有意差タンパク質を抽出し、可視化用の色設定を行います。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- 有意差タンパク質の抽出 ---\n",
    "# 検定結果から有意差あり（UpまたはDown）のタンパク質だけを抽出する\n",
    "sig_df = result_df[result_df[\"Significant\"] != \"NS\"]\n",
    "# 元の発現量データから有意差タンパク質の行だけを取り出す\n",
    "sig_data = df.loc[df.index.isin(sig_df[\"Protein\"])]\n",
    "# 各タンパク質の発現変化方向（Log2FC）をSeriesとして取得する（色分けに使用）\n",
    "direction = sig_df.set_index(\"Protein\")[\"Log2FC\"]\n",
    "\n",
    "print(f\"📊 有意差タンパク質データ:\")\n",
    "print(f\"  - 抽出されたタンパク質数: {len(sig_data):,}\")\n",
    "print(f\"  - データ形状: {sig_data.shape[0]} タンパク質 × {sig_data.shape[1]} サンプル\")\n",
    "print(f\"  - 発現上昇 (Log2FC > 0): {(direction > 0).sum():,} 個\")\n",
    "print(f\"  - 発現低下 (Log2FC < 0): {(direction < 0).sum():,} 個\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 各サンプルの条件（Normal/Tumor）に応じた色をSeriesとして作成する（ヒートマップの行カラーバーに使用）\n",
    "sample_colors = conditions.reindex(df.columns).map(COND_MAP)\n",
    "# 各タンパク質の発現変化方向に応じた色をSeriesとして作成する（ヒートマップの列カラーバーに使用）\n",
    "# Log2FC > 0 なら赤（Up: 腫瘍で増加）、それ以外は青（Down: 腫瘍で減少）\n",
    "protein_colors = pd.Series(\n",
    "    sig_data.index.map(lambda p: UP if direction.get(p, 0) > 0 else DOWN),\n",
    "    index=sig_data.index, name=\"Expression\"\n",
    ")\n",
    "\n",
    "print(f\"🎨 色設定完了:\")\n",
    "print(f\"  - サンプル色: Normal({(sample_colors == NORMAL).sum()}) vs Tumor({(sample_colors == TUMOR).sum()})\")\n",
    "print(f\"  - タンパク質色: Up({(protein_colors == UP).sum()}) vs Down({(protein_colors == DOWN).sum()})\")\n",
    "\n",
    "# データの統計サマリーを表示\n",
    "print(f\"\")\n",
    "print(f\"📈 有意差タンパク質の発現統計:\")\n",
    "print(f\"  - 発現値範囲: {sig_data.values.min():.2f} ~ {sig_data.values.max():.2f} (log2)\")\n",
    "print(f\"  - 平均発現値: {sig_data.values.mean():.2f} (log2)\")\n",
    "print(f\"  - 欠損値: {sig_data.isnull().sum().sum()} 個\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 🔥 Figure 2a: 有意差タンパク質のヒートマップ\n",
    "\n",
    "階層的クラスタリング付きヒートマップで有意差タンパク質の発現パターンを可視化します。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_differential_heatmap(sig_data, sample_colors, protein_colors):\n",
    "    \"\"\"有意差タンパク質の階層的クラスタリング付きヒートマップを作成・保存する。\n",
    "    \n",
    "    Args:\n",
    "        sig_data: 有意差タンパク質の発現データ\n",
    "        sample_colors: サンプルの色設定\n",
    "        protein_colors: タンパク質の色設定\n",
    "    \"\"\"\n",
    "    print(f\"🔥 有意差タンパク質ヒートマップ生成中...\")\n",
    "    print(f\"  - 対象タンパク質: {len(sig_data):,} 個\")\n",
    "    print(f\"  - 対象サンプル: {len(sig_data.columns)} 個\")\n",
    "    \n",
    "    # --- Figure 2a: ヒートマップ ---\n",
    "    # 階層的クラスタリング付きヒートマップを作成する\n",
    "    g = sns.clustermap(\n",
    "        sig_data.T,              # データを転置する（行=サンプル、列=タンパク質にする）\n",
    "        method=\"ward\",           # Ward法でクラスタリングする（分散を最小化する手法）\n",
    "        cmap=\"RdBu_r\",           # カラーマップ: 赤=高発現、青=低発現（反転版）\n",
    "        z_score=1,               # 列方向（タンパク質ごと）に標準化する（平均0、標準偏差1に変換）\n",
    "        row_colors=sample_colors,   # 行（サンプル）の横にNormal/Tumorの色バーを表示する\n",
    "        col_colors=protein_colors,  # 列（タンパク質）の上にUp/Downの色バーを表示する\n",
    "        xticklabels=False,       # x軸のタンパク質名ラベルを非表示にする（数が多すぎて読めないため）\n",
    "        yticklabels=True,        # y軸のサンプル名ラベルを表示する\n",
    "        figsize=(12, 8),         # 図のサイズを横12×縦8インチに設定する\n",
    "        vmin=-3, vmax=3,         # 色の範囲を-3〜+3に制限する（外れ値による色の偏りを防ぐ）\n",
    "        cbar_pos=(1.02, 0.15, 0.03, 0.7),  # カラーバーの位置とサイズ調整\n",
    "    )\n",
    "    \n",
    "    # y軸のサンプル名のフォントサイズを小さくして見やすくする\n",
    "    g.ax_heatmap.set_yticklabels(g.ax_heatmap.get_yticklabels(), fontsize=7)\n",
    "    # x軸とy軸のラベルを設定\n",
    "    g.ax_heatmap.set_xlabel(\"Differentially Abundant Proteins\", fontsize=10)\n",
    "    g.ax_heatmap.set_ylabel(\"Samples\", fontsize=10)\n",
    "    \n",
    "    # タイトルを追加\n",
    "    g.fig.suptitle(f\"Deep Learning DIA: Heatmap of Differentially Abundant Proteins\\n({len(sig_data):,} proteins)\", \n",
    "                   fontsize=12, fontweight='bold', y=0.95)\n",
    "    \n",
    "    # ヒートマップをPNGファイルとして保存する\n",
    "    output_path = FIG_DIR / \"fig2a_heatmap_all.png\"\n",
    "    g.savefig(output_path, dpi=150, bbox_inches=\"tight\")\n",
    "    plt.close()\n",
    "    \n",
    "    print(f\"💾 ヒートマップ保存: {output_path}\")\n",
    "    return output_path\n",
    "\n",
    "# ヒートマップを作成・保存\n",
    "heatmap_path = create_differential_heatmap(sig_data, sample_colors, protein_colors)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 📍 Figure 2b: 有意差タンパク質のPCA解析\n",
    "\n",
    "有意差タンパク質を使用したPCA解析で群分離能力を評価します。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_differential_pca(sig_data, conditions, df_columns):\n",
    "    \"\"\"有意差タンパク質を使用したPCA解析を実行・可視化する。\n",
    "    \n",
    "    Args:\n",
    "        sig_data: 有意差タンパク質の発現データ\n",
    "        conditions: サンプル条件情報\n",
    "        df_columns: 全データのカラム名\n",
    "    \n",
    "    Returns:\n",
    "        PCAオブジェクト, スコア配列, 出力ファイルパス\n",
    "    \"\"\"\n",
    "    print(f\"📍 有意差タンパク質PCA解析実行中...\")\n",
    "    print(f\"  - 入力データ: {sig_data.shape[0]:,} タンパク質 × {sig_data.shape[1]} サンプル\")\n",
    "    \n",
    "    # --- Figure 2b: PCA ---\n",
    "    # 主成分分析（PCA）オブジェクトを作成する（2次元に次元削減する）\n",
    "    pca = PCA(n_components=2)\n",
    "    # 有意差タンパク質の発現データでPCAを実行する（転置して行=サンプルにする）\n",
