    "    scores = pca.fit_transform(sig_data.T)\n",
    "    \n",
    "    # 寄与率を取得\n",
    "    explained_var = pca.explained_variance_ratio_\n",
    "    print(f\"  - PC1寄与率: {explained_var[0]*100:.1f}%\")\n",
    "    print(f\"  - PC2寄与率: {explained_var[1]*100:.1f}%\")\n",
    "    print(f\"  - 累積寄与率: {sum(explained_var)*100:.1f}%\")\n",
    "    \n",
    "    # PCAプロット用の図と軸を作成する\n",
    "    fig, ax = plt.subplots(figsize=(10, 7))\n",
    "    \n",
    "    # Normal群とTumor群をそれぞれ異なる色でプロットする\n",
    "    for cond, color in [(\"Normal\", NORMAL), (\"Tumor\", TUMOR)]:\n",
    "        # 各サンプルが現在の条件に該当するかのブールマスクを作成する\n",
    "        m = (conditions.reindex(df_columns) == cond).values\n",
    "        n_samples = m.sum()\n",
    "        \n",
    "        print(f\"  - {cond}群: {n_samples} サンプル\")\n",
    "        \n",
    "        # 散布図を描画する（s=80: 点のサイズ、alpha=0.8: やや透明、edgecolors=\"white\": 白い縁取り）\n",
    "        ax.scatter(scores[m, 0], scores[m, 1], c=color, s=100, alpha=0.8,\n",
    "                  label=f\"{cond} (n={n_samples})\", edgecolors=\"white\", linewidth=0.5)\n",
    "        \n",
    "        # 95%信頼楕円を描画する（群の分布範囲を視覚的に示す）\n",
    "        confidence_ellipse(scores[m, 0], scores[m, 1], ax,\n",
    "                           facecolor=color, alpha=0.15, edgecolor=color, lw=1.5)\n",
    "    \n",
    "    # x軸ラベル: 第1主成分と寄与率（全分散のうちPC1が説明する割合）を表示する\n",
    "    ax.set_xlabel(f\"Component 1 ({explained_var[0]*100:.1f}%)\", fontsize=12)\n",
    "    # y軸ラベル: 第2主成分と寄与率を表示する\n",
    "    ax.set_ylabel(f\"Component 2 ({explained_var[1]*100:.1f}%)\", fontsize=12)\n",
    "    # グラフタイトル: 深層学習DIA解析の全有意差タンパク質を使ったPCA\n",
    "    ax.set_title(f\"Deep Learning DIA: PCA using Differentially Abundant Proteins\\n({sig_data.shape[0]:,} proteins, {sum(explained_var)*100:.1f}% variance explained)\", \n",
    "                fontsize=13, fontweight='bold')\n",
    "    \n",
    "    # 凡例を表示する（frameon=Trueで枠線ありにして見やすく）\n",
