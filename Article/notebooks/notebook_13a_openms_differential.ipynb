   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 🌋 Volcanoプロットの作成\n",
    "\n",
    "統計検定結果をVolcanoプロットで可視化し、有意に変動するタンパク質を視覚的に確認します。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_volcano_plot(result_df, p_threshold, log2fc_threshold):\n",
    "    \"\"\"Volcanoプロットを作成・保存する。\n",
    "    \n",
    "    Args:\n",
    "        result_df: 統計検定結果のDataFrame\n",
    "        p_threshold: P値の閾値\n",
    "        log2fc_threshold: Log2FC の閾値\n",
    "    \"\"\"\n",
    "    print(\"🌋 Volcanoプロット作成中...\")\n",
    "    \n",
    "    # 図と軸オブジェクトを作成する（figsize=(横10, 縦7)インチ）\n",
    "    fig, ax = plt.subplots(figsize=(10, 7))\n",
    "    \n",
    "    # NS（非有意）→ Up（増加）→ Down（減少）の順にプロットする\n",
    "    # NSを先に描画することで、有意な点が上に表示されて見やすくなる\n",
    "    plot_order = [(\"NS\", NS, 0.3, 8), (\"Up\", UP, 0.7, 12), (\"Down\", DOWN, 0.7, 12)]\n",
    "    \n",
    "    for sig, color, alpha, size in plot_order:\n",
    "        # 各カテゴリに該当するタンパク質のブールマスクを作成する\n",
    "        m = result_df[\"Significant\"] == sig\n",
    "        n_proteins = m.sum()\n",
    "        \n",
    "        if n_proteins > 0:  # 該当するタンパク質がある場合のみプロット\n",
    "            # 散布図を描画する（x=発現変化量, y=統計的有意性）\n",
    "            # c: 点の色, s: 点のサイズ, alpha: 透明度（NSは薄く表示）\n",
    "            ax.scatter(result_df.loc[m, \"Log2FC\"], result_df.loc[m, \"Neg_log10_P\"],\n",
    "                      c=color, s=size, alpha=alpha, \n",
    "                      label=f\"{sig} ({n_proteins:,})\", \n",
    "                      edgecolors='white', linewidth=0.3)\n",
    "            \n",
    "            print(f\"  - {sig}: {n_proteins:,} タンパク質 (色: {color})\")\n",
    "    \n",
    "    # 統計的有意性の閾値ライン（水平破線）: この線より上が統計的に有意\n",
    "    significance_line = -np.log10(p_threshold)\n",
    "    ax.axhline(significance_line, color=\"gray\", ls=\"--\", lw=1, alpha=0.7)\n",
    "    ax.text(0, significance_line + 0.1, f'P = {p_threshold}', \n",
    "            ha='center', va='bottom', fontsize=9, color='gray')\n",
    "    \n",
    "    # log2FCの正の閾値ライン（垂直破線）: この線より右が2倍以上の増加\n",
    "    ax.axvline(log2fc_threshold, color=\"gray\", ls=\"--\", lw=1, alpha=0.7)\n",
    "    ax.text(log2fc_threshold + 0.1, ax.get_ylim()[1] * 0.9, \n",
    "            f'FC = {2**log2fc_threshold:.1f}x', \n",
    "            ha='left', va='top', fontsize=9, color='gray', rotation=90)\n",
    "    \n",
    "    # log2FCの負の閾値ライン（垂直破線）: この線より左が2倍以上の減少\n",
    "    ax.axvline(-log2fc_threshold, color=\"gray\", ls=\"--\", lw=1, alpha=0.7)\n",
    "    ax.text(-log2fc_threshold - 0.1, ax.get_ylim()[1] * 0.9, \n",
    "            f'FC = {1/(2**log2fc_threshold):.1f}x', \n",
    "            ha='right', va='top', fontsize=9, color='gray', rotation=90)\n",
    "    \n",
    "    # x軸ラベル: 発現変化の方向と大きさを示す\n",
    "    ax.set_xlabel(\"Log2 Fold Change (Tumor / Normal)\", fontsize=12)\n",
    "    # y軸ラベル: 統計的有意性を示す（値が大きいほど有意）\n",
    "    ax.set_ylabel(\"-Log10(P-value)\", fontsize=12)\n",
    "    # グラフタイトル: 深層学習DIA解析での差分タンパク質量解析\n",
    "    ax.set_title(\"Deep Learning DIA: Differential Protein Abundance\\n(Tumor vs Non-tumor)\", \n",
    "                fontsize=14, fontweight='bold')\n",
    "    \n",
    "    # 凡例を右上に表示する（frameon=Falseで枠線を非表示にしてすっきりさせる）\n",
    "    ax.legend(frameon=True, loc=\"upper right\", fontsize=10, \n",
    "              fancybox=True, shadow=True, framealpha=0.9)\n",
    "    \n",
    "    # グリッド線を薄く表示\n",
    "    ax.grid(True, alpha=0.3, linestyle='-', linewidth=0.5)\n",
    "    \n",
    "    # 上辺と右辺の枠線を非表示にする（学術論文スタイルのすっきりした見た目にする）\n",
