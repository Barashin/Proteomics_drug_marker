    "def create_quality_summary_visualization(final_score, quality_metrics, detection_outliers, cv_outliers):\n",
    "    \"\"\"品質評価の総合サマリー可視化\"\"\"\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "\n",
    "    # 1. 品質スコアのゲージチャート風表示\n",
    "    score_colors = ['#FF6B6B', '#FFD93D', '#6BCF7F', '#4EAED1']\n",
    "    score_labels = ['Poor\\n(0-39)', 'Fair\\n(40-59)', 'Good\\n(60-79)', 'Excellent\\n(80-100)']\n",
    "    score_ranges = [40, 20, 20, 20]\n",
    "    \n",
    "    # 円グラフでスコア表示\n",
    "    axes[0].pie(score_ranges, colors=score_colors, labels=score_labels, startangle=180)\n",
    "    \n",
    "    # スコア位置にマーカーを追加\n",
    "    angle = 180 - (final_score / 100) * 180\n",
    "    x = 0.8 * np.cos(np.radians(angle))\n",
    "    y = 0.8 * np.sin(np.radians(angle))\n",
    "    axes[0].plot([0, x], [0, y], 'ro-', linewidth=3, markersize=10)\n",
    "    axes[0].set_title(f'Quality Score\\n{final_score}/100', fontsize=14, fontweight='bold')\n",
    "\n",
    "    # 2. サンプル品質分布\n",
    "    normal_data = quality_metrics[quality_metrics['Condition'] == 'Normal']\n",
    "    tumor_data = quality_metrics[quality_metrics['Condition'] == 'Tumor']\n",
    "    \n",
    "    x_pos = np.arange(len(normal_data) + len(tumor_data))\n",
    "    combined_detection = pd.concat([normal_data['Detection_Count'], tumor_data['Detection_Count']])\n",
    "    colors = [NORMAL_COLOR] * len(normal_data) + [TUMOR_COLOR] * len(tumor_data)\n",
    "    \n",
    "    bars = axes[1].bar(x_pos, combined_detection, color=colors, alpha=0.7)\n",
    "    \n",
    "    # 外れ値をハイライト\n",
    "    if len(detection_outliers) > 0:\n",
    "        outlier_indices = []\n",
    "        for _, outlier in detection_outliers.iterrows():\n",
    "            sample_idx = quality_metrics[quality_metrics['Sample'] == outlier['Sample']].index[0]\n",
    "            bars[sample_idx].set_edgecolor('red')\n",
    "            bars[sample_idx].set_linewidth(3)\n",
    "    \n",
    "    axes[1].axvline(len(normal_data) - 0.5, color='black', linestyle='--', alpha=0.5)\n",
    "    axes[1].set_xlabel('Samples')\n",
    "    axes[1].set_ylabel('Detected Proteins')\n",
    "    axes[1].set_title('Sample Detection Counts\\n(Red outline = outliers)')\n",
    "\n",
    "    # 3. 品質指標レーダーチャート\n",
    "    if len(correlation_stats) > 0:\n",
    "        try:\n",
    "            # 正規化された指標値（0-1）\n",
    "            data_density_norm = min(quality_metrics['Detection_Count'].mean() / df.shape[0], 1.0)\n",
    "            normal_corr = correlation_stats[correlation_stats['Correlation_Type']=='Normal_Within']['Mean_Correlation'].iloc[0]\n",
    "            tumor_corr = correlation_stats[correlation_stats['Correlation_Type']=='Tumor_Within']['Mean_Correlation'].iloc[0]\n",
    "            repro_norm = (normal_corr + tumor_corr) / 2\n",
    "            cv_norm = max(0, 1 - quality_metrics['CV'].median() / 0.5)  # CV=0.5で0点\n",
    "            between_corr = correlation_stats[correlation_stats['Correlation_Type']=='Between_Groups']['Mean_Correlation'].iloc[0]\n",
    "            separation_norm = max(0, min(1, ((normal_corr + tumor_corr)/2 - between_corr) / 0.2))\n",
    "            \n",
    "            categories = ['Data\\nDensity', 'Repro-\\nducibility', 'Precision', 'Group\\nSeparation']\n",
    "            values = [data_density_norm, repro_norm, cv_norm, separation_norm]\n",
    "            \n",
    "            # レーダーチャートの角度\n",
    "            angles = np.linspace(0, 2 * np.pi, len(categories), endpoint=False).tolist()\n",
    "            values += values[:1]  # 円を閉じる\n",
    "            angles += angles[:1]\n",
    "            \n",
    "            axes[2].plot(angles, values, 'o-', linewidth=2, color='#2E86C1')\n",
    "            axes[2].fill(angles, values, color='#2E86C1', alpha=0.25)\n",
    "            axes[2].set_xticks(angles[:-1])\n",
    "            axes[2].set_xticklabels(categories)\n",
    "            axes[2].set_ylim(0, 1)\n",
    "            axes[2].set_title('Quality Radar Chart')\n",
    "            axes[2].grid(True)\n",
    "        except:\n",
    "            axes[2].text(0.5, 0.5, 'Correlation data\\nnot available', \n",
    "                        ha='center', va='center', transform=axes[2].transAxes)\n",
    "            axes[2].set_title('Quality Radar Chart')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig(f\"{FIG_DIR}/quality_summary_dashboard.png\", dpi=150, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    \n",
    "    print(f\"🎨 品質サマリー図を保存: {FIG_DIR}/quality_summary_dashboard.png\")\n",
    "\n",
    "# 品質サマリー可視化の実行\n",
    "create_quality_summary_visualization(final_quality_score, quality_metrics, detection_outliers, cv_outliers)"
   ]
