    "# 品質指標の基本統計\n",
    "print(\"=== 📊 品質指標の詳細分析 ===\")\n",
    "display(quality_metrics.describe())\n",
    "\n",
    "# 条件別の品質指標比較\n",
    "print(f\"\\n=== Normal vs Tumor 品質比較 ===\")\n",
    "normal_metrics = quality_metrics[quality_metrics['Condition'] == 'Normal']\n",
    "tumor_metrics = quality_metrics[quality_metrics['Condition'] == 'Tumor']\n",
    "\n",
    "print(f\"📊 検出数比較:\")\n",
    "print(f\"  Normal群: {normal_metrics['Detection_Count'].mean():.0f} ± {normal_metrics['Detection_Count'].std():.0f} タンパク質\")\n",
    "print(f\"  Tumor群: {tumor_metrics['Detection_Count'].mean():.0f} ± {tumor_metrics['Detection_Count'].std():.0f} タンパク質\")\n",
    "\n",
    "print(f\"\\n📊 変動係数比較:\")\n",
    "print(f\"  Normal群: {normal_metrics['CV'].mean():.3f} ± {normal_metrics['CV'].std():.3f}\")\n",
    "print(f\"  Tumor群: {tumor_metrics['CV'].mean():.3f} ± {tumor_metrics['CV'].std():.3f}\")\n",
    "\n",
    "# 統計的検定\n",
    "from scipy.stats import mannwhitneyu\n",
    "\n",
    "# 検出数の差の検定\n",
    "stat_det, p_det = mannwhitneyu(normal_metrics['Detection_Count'], tumor_metrics['Detection_Count'])\n",
    "print(f\"\\n📈 群間検定結果:\")\n",
    "print(f\"  検出数の差: p = {p_det:.3f} ({'有意' if p_det < 0.05 else '非有意'})\")\n",
    "\n",
    "# 変動係数の差の検定\n",
    "stat_cv, p_cv = mannwhitneyu(normal_metrics['CV'].dropna(), tumor_metrics['CV'].dropna())\n",
    "print(f\"  CV の差: p = {p_cv:.3f} ({'有意' if p_cv < 0.05 else '非有意'})\")"
   ]
