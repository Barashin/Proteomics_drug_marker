   "source": [
    "# 前処理済みのタンパク質発現データを読み込み（行=タンパク質、列=サンプル、値=log2発現量）\n",
    "try:\n",
    "    df = pd.read_csv(f\"{RESULTS}/preprocessed_data.csv\", index_col=0)\n",
    "    print(f\"✅ データ読み込み成功: {df.shape[0]} タンパク質 × {df.shape[1]} サンプル\")\n",
    "except FileNotFoundError:\n",
    "    print(\"❌ 前処理データが見つかりません。代替として生の protein matrix を使用します\")\n",
    "    # 代替データの読み込み\n",
    "    df = pd.read_csv(f\"{RESULTS}/protein_matrix_from_sage.csv\", index_col=0)\n",
    "    # 簡易前処理（Log2変換）\n",
    "    df = np.log2(df + 1)  # +1は0値対策\n",
    "    print(f\"⚠️ 代替データ使用: {df.shape[0]} タンパク質 × {df.shape[1]} サンプル\")\n",
    "\n",
    "# サンプル情報（サンプル名と群の対応）を読み込み\n",
    "try:\n",
    "    sample_info = pd.read_csv(f\"{RESULTS}/sample_info.csv\")\n",
    "    print(f\"✅ サンプル情報読み込み成功: {len(sample_info)} サンプル\")\n",
    "except FileNotFoundError:\n",
    "    print(\"⚠️ サンプル情報ファイルが見つかりません。サンプル名から推定します\")\n",
    "    # サンプル名から群情報を推定\n",
    "    sample_info = []\n",
    "    for sample in df.columns:\n",
    "        if '-N' in sample:\n",
    "            condition = 'Normal'\n",
    "            patient = sample.replace('-N', '')\n",
    "        elif '-T' in sample:\n",
    "            condition = 'Tumor'\n",
    "            patient = sample.replace('-T', '')\n",
    "        else:\n",
    "            condition = 'Unknown'\n",
    "            patient = sample\n",
    "        \n",
    "        sample_info.append({\n",
    "            'Sample': sample,\n",
    "            'Condition': condition,\n",
    "            'Patient': patient\n",
    "        })\n",
    "    \n",
    "    sample_info = pd.DataFrame(sample_info)\n",
    "    print(f\"✅ サンプル情報を推定: {len(sample_info)} サンプル\")\n",
    "\n",
    "# サンプル情報から「サンプル名→群」の対応Seriesを作成（索引で使いやすくする）\n",
    "conditions = sample_info.set_index(\"Sample\")[\"Condition\"]\n",
    "\n",
    "print(f\"\\n📊 データ概要:\")\n",
    "print(f\"  Sage解析データ: {df.shape[0]} タンパク質 × {df.shape[1]} サンプル\")\n",
    "print(f\"  サンプル群構成: {dict(conditions.value_counts())}\")\n",
    "print(f\"  データ範囲: {df.min().min():.2f} 〜 {df.max().max():.2f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- 色設定（視覚的に区別しやすい色を設定） ---\n",
    "# サンプル群ごとの色を定義：Normal(正常)=青、Tumor(腫瘍)=赤\n",
    "condition_color_map = {\"Normal\": \"#3498DB\", \"Tumor\": \"#E74C3C\"}\n",
    "sample_colors = conditions.map(condition_color_map)\n",
    "\n",
    "print(\"🎨 色設定:\")\n",
    "for condition, color in condition_color_map.items():\n",
    "    count = sum(conditions == condition)\n",
    "    print(f\"  {condition}: {color} ({count} サンプル)\")\n",
    "\n",
    "# 以下の設定はクラスタリングで使用：腫瘍で上昇=赤、低下=青（直感的な色分け）\n",
    "# 実際の差分解析結果がある場合はそれを使用、ここでは可視化のためランダム色を設定\n",
    "np.random.seed(42)  # 再現性のためのシード固定\n",
    "protein_colors = [\"#E74C3C\" if np.random.rand() > 0.5 else \"#3498DB\"\n",
    "                  for _ in range(len(df.index))]  # タンパク質数分のランダム色（実際は差分解析結果で決定）\n",
    "\n",
    "print(f\"\\n🧬 タンパク質色設定: {len(protein_colors)} タンパク質（赤/青ランダム配色）\")"
   ]
