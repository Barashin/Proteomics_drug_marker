    "# クラスタリング結果の定量評価\n",
    "print(\"=== 🌳 クラスタリング結果評価 ===\")\n",
    "\n",
    "# デンドログラムの階層構造を分析\n",
    "from scipy.cluster.hierarchy import linkage, fcluster\n",
    "from scipy.spatial.distance import pdist\n",
    "\n",
    "# Ward法による階層的クラスタリングを実行\n",
    "# df.Tでサンプル×タンパク質の形にして距離計算\n",
    "distance_matrix = pdist(df.T, metric='euclidean')\n",
    "linkage_matrix = linkage(distance_matrix, method='ward')\n",
    "\n",
    "# 2クラスタに分割したときの結果\n",
    "clusters_2 = fcluster(linkage_matrix, 2, criterion='maxclust')\n",
    "cluster_assignments = pd.Series(clusters_2, index=df.columns, name='Cluster')\n",
    "\n",
    "# クラスター vs 実際の群の対応表を作成\n",
    "cluster_comparison = pd.DataFrame({\n",
    "    'Sample': df.columns,\n",
    "    'True_Condition': conditions.reindex(df.columns),\n",
    "    'Cluster': cluster_assignments\n"})\n",
    "\n",
    "print(f\"📊 クラスタリング結果（2クラスタ）:\")\n",
    "crosstab = pd.crosstab(cluster_comparison['True_Condition'], \n",
    "                       cluster_comparison['Cluster'], \n",
    "                       margins=True)\n",
    "display(crosstab)\n",
    "\n",
    "# 分類精度の計算\n",
    "total_samples = len(cluster_comparison)\n",
    "# 各クラスタで多数派の群を正解として扱う\n",
    "cluster_1_samples = cluster_comparison[cluster_comparison['Cluster'] == 1]\n",
    "cluster_2_samples = cluster_comparison[cluster_comparison['Cluster'] == 2]\n",
    "\n",
    "if len(cluster_1_samples) > 0 and len(cluster_2_samples) > 0:\n",
    "    # クラスター1の多数派\n",
    "    cluster_1_majority = cluster_1_samples['True_Condition'].value_counts().index[0]\n",
    "    cluster_1_accuracy = (cluster_1_samples['True_Condition'] == cluster_1_majority).sum()\n",
    "    \n",
    "    # クラスター2の多数派\n",
    "    cluster_2_majority = cluster_2_samples['True_Condition'].value_counts().index[0]\n",
    "    cluster_2_accuracy = (cluster_2_samples['True_Condition'] == cluster_2_majority).sum()\n",
    "    \n",
    "    total_correct = cluster_1_accuracy + cluster_2_accuracy\n",
    "    accuracy = total_correct / total_samples\n",
    "    \n",
    "    print(f\"\\n✨ 教師なし分類性能:\")\n",
    "    print(f\"  クラスター1 主要群: {cluster_1_majority} ({cluster_1_accuracy}/{len(cluster_1_samples)} 正解)\")\n",
    "    print(f\"  クラスター2 主要群: {cluster_2_majority} ({cluster_2_accuracy}/{len(cluster_2_samples)} 正解)\")\n",
    "    print(f\"  全体精度: {accuracy:.1%} ({total_correct}/{total_samples})\")\n",
    "    \n",
    "    if accuracy >= 0.9:\n",
    "        print(f\"  判定: 🌟 優秀な群分離\")\n",
    "    elif accuracy >= 0.8:\n",
    "        print(f\"  判定: ✅ 良好な群分離\")\n",
    "    elif accuracy >= 0.7:\n",
    "        print(f\"  判定: ⚠️ 中程度の群分離\")\n",
    "    else:\n",
    "        print(f\"  判定: ❌ 群分離不十分\")\nelse:\n",
    "    print(f\"\\n⚠️ クラスタリング評価: サンプル数不足\")"
